# Copy to .coze after backing up the platform's current configuration.
# Enable the Coze database first. Do not paste connection secrets into this file.
# Set an initial TEACHER_PASSWORD through the deployment environment if needed;
# it never replaces the password already stored in the database.
[project]
requires = ["nodejs-24"]

[dev]
build = ["pnpm", "install"]
run = ["sh", "-c", "PORT=${DEPLOY_RUN_PORT:-5000} REQUIRE_SHARED_DATABASE=true SYNC_MODE=polling PUBLIC_URL=${PUBLIC_URL:-${COZE_PROJECT_DOMAIN_DEFAULT}},$(echo ${COZE_PROJECT_DOMAIN_DEFAULT} | sed 's/\\.dev\\.coze\\.site/-5000.dev.coze.site/') node --env-file-if-exists=.env --watch-path=./server --watch-path=./config server/index.js --dev"]

[deploy]
build = ["sh", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "PORT=${DEPLOY_RUN_PORT:-5000} HOST=0.0.0.0 REQUIRE_SHARED_DATABASE=true SYNC_MODE=polling SCHOOLS_FILE=./config/schools.json COOKIE_SECURE=true PUBLIC_URL=${PUBLIC_URL:-${COZE_PROJECT_DOMAIN_DEFAULT}},$(echo ${COZE_PROJECT_DOMAIN_DEFAULT} | sed 's/\\.dev\\.coze\\.site/-5000.dev.coze.site/') node --env-file-if-exists=.env server/index.js"]
