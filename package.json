{
  "name": "ai-classroom-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server/app.js && node --check server/store.js && npm test && npm run build",
    "password:reset": "node --env-file-if-exists=.env scripts/reset-password.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.7"
  },
  "description": "AI 共创课堂：一起发现，一起设计"
}
