HOST=0.0.0.0
PORT=3218
DATA_DIR=./data
# Hosted deployments must point DATA_DIR at a persistent volume/directory.
# Replacing this database creates new classroom IDs and invalidates old links.
# Optional: use the actual student-facing address to generate the join QR code.
# PUBLIC_URL=https://classroom.example.edu
# true only when students access the application over HTTPS.
COOKIE_SECURE=false
# Optional school JSON path; restart after changing the file.
SCHOOLS_FILE=./config/schools.json
# Optional initial password (8+ characters). Used only on first startup.
# If omitted, a random password is printed once in the server terminal.
# TEACHER_PASSWORD=

# Multi-instance hosting: PostgreSQL is selected by DATABASE_URL / PGDATABASE_URL
# or the standard PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE, PGSSLMODE.
# Coze injects the standard PG* variables after enabling its database.
# DATABASE_URL=
# REQUIRE_SHARED_DATABASE=true
# SYNC_MODE=polling
# DATABASE_SCHEMA=public
